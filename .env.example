# Robin configuration. Copy to .env and fill in only what you actually use.
# Robin lists models for the providers it finds a key for, so a file containing
# a single key is perfectly valid. Do not wrap values in quotes.

# --- Hosted providers -------------------------------------------------------
# Fill in the ones you have. Delete or ignore the rest.
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_API_KEY=your_google_api_key
MISTRAL_API_KEY=your_mistral_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Leave as-is unless you route OpenRouter through your own gateway.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Ollama -----------------------------------------------------------------
# Default below is for the recommended Docker install, where the container
# reaches Ollama on the host. Run the container with
#   --add-host=host.docker.internal:host-gateway
# and serve Ollama on all interfaces, not just loopback:
#   OLLAMA_HOST=0.0.0.0 ollama serve &
# Running Robin directly with Python instead? Use http://127.0.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Other local / OpenAI-compatible servers --------------------------------
# Uncomment only if you run these. Robin probes every URL it is given, so
# leaving an unused one set makes startup slower for no benefit.
# LLAMA_CPP_BASE_URL=http://host.docker.internal:8080
# CUSTOM_API_BASE_URL=http://host.docker.internal:1234/v1
# CUSTOM_API_KEY=your_custom_api_key
# CUSTOM_API_MODEL=your_custom_model_name
