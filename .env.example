# Copy this file to .env and fill in the keys for the providers you use.
# One key is enough. Robin lists models for whichever providers it finds.
# Do not wrap values in quotes.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Everything else has a working default in config.py, including Ollama, which is
# preconfigured for the Docker install. Add a line here only to override one:
#
#   OLLAMA_BASE_URL=http://127.0.0.1:11434     running Robin without Docker
#   LLAMA_CPP_BASE_URL=http://host.docker.internal:8080
#   CUSTOM_API_BASE_URL=http://host.docker.internal:1234/v1
#   CUSTOM_API_KEY=
#   CUSTOM_API_MODEL=
#   OPENROUTER_BASE_URL=                       a custom OpenRouter gateway
#   OLLAMA_NUM_CTX=8192                        lower for a RAM-constrained machine

# Running Robin as an MCP server
# (`docker run -i --rm -v robin-investigations:/app/investigations apurvsg/robin mcp`)?
# The volume keeps saved reports after the container stops. Your agent's own
# model does the thinking, so none of these are required. Add a line only to
# change one:
#
#   ROBIN_MODEL=                               a model for robin_investigate
#   ROBIN_INVESTIGATIONS_DIR=investigations    where reports are saved
#   ROBIN_CACHE_DIR=                           where the model cache lives
#   ROBIN_TOR_LOG=                             Tor's notice log, read to tell
#                                              bootstrapped from port-open
#
# Persistent depth defaults, used by the web UI and the MCP server alike, so a
# preference is stated once here instead of on every run:
#
#   ROBIN_DEFAULT_PRESET=threat_intel          the research domain to start on
#   ROBIN_DEFAULT_THREADS=4                    scrape workers, 1 to 16
#   ROBIN_DEFAULT_MAX_RESULTS=50               results to filter, 10 to 100
#   ROBIN_DEFAULT_MAX_SCRAPE=10                pages to scrape, 3 to 20
#   ROBIN_DEFAULT_CONTENT_CHARS=8000           chars per page, 1000 to 20000
